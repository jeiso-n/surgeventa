# ==============================================================================
# Surgeventa — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env`, `.env.local`, or real secrets to GitHub.
# All values below are safe placeholders only.

# ------------------------------------------------------------------------------
# Application Core
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Surgeventa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="UTC"

# ------------------------------------------------------------------------------
# Database — Neon PostgreSQL (Free Tier Compatible & Portable)
# ------------------------------------------------------------------------------
# Pooled connection string (used by the application at runtime; includes `-pooler` on Neon).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT-pooler.REGION.aws.neon.tech/surgeventa?sslmode=require"

# Direct unpooled connection string (used ONLY by Drizzle Kit migrations/CLI).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT.REGION.aws.neon.tech/surgeventa?sslmode=require"

# ------------------------------------------------------------------------------
# Authentication & Cryptography (Required before Milestone 2+ auth/OAuth)
# ------------------------------------------------------------------------------
# Minimum 32-character random secret for session signing.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_64_CHAR_HEX_AUTH_SECRET"

# 32-byte key encoded as 64 hex characters for AES-256-GCM encryption of OAuth tokens at rest.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_ENCRYPTION_KEY"

# Shared bearer secret protecting internal scheduled publishing trigger endpoint.
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"

# ------------------------------------------------------------------------------
# Media Storage (Zero-Spend Portable Adapter)
# ------------------------------------------------------------------------------
# Supported modes: "local" (local filesystem dev/self-host) | "s3" (S3-compatible object storage)
MEDIA_STORAGE_PROVIDER="local"
LOCAL_MEDIA_DIR="./storage/local"
MAX_MEDIA_UPLOAD_MB="50"

# Optional S3-compatible object storage credentials (leave blank while using local storage)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Social Platform OAuth Credentials (Official Free APIs Only — Configure per platform)
# ------------------------------------------------------------------------------
# Meta (Facebook Pages, Instagram Business/Creator, Threads)
META_APP_ID=""
META_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# Google / YouTube Data API v3
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# LinkedIn (Sign In & Share on LinkedIn)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Pinterest API v5
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Reddit Data API (only if user has an approved official non-commercial OAuth app; otherwise assisted mode)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# X (Twitter) — Defaults to Assisted Publishing under zero-spend rules (X API v2 is pay-per-use).
# Leave unset unless explicitly opting into a paid X API credit plan.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
